{
  "name": "biz-rescue-pro-website",
  "private": true,
  "scripts": {
    "dev": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "build": "npm run build:css && node scripts/build-site.mjs",
    "import": "node scripts/import-wp.mjs",
    "images": "node scripts/fetch-images.mjs",
    "photos": "node scripts/photos.mjs",
    "preview": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "fast-xml-parser": "^5.12.0",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.17"
  }
}
